[sqlfluff]
templater = dbt
dialect = bigquery
# We put all ignores here. No spaces after commas.
exclude_rules = CP01,LT05,ST06,JJ01,LT02
ignore = macros,target,dbt_packages,templating
indent_unit = space
tab_space_size = 2
max_line_length = 300
fix_even_unparsable = True

[sqlfluff:templater:dbt]
project_dir = .

[sqlfluff:indentation]
indented_joins = False
indented_using_on = True

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:aliasing.column]
aliasing_specification = explicit

[sqlfluff:rules:layout.commas]
line_position = trailing

[sqlfluff:rules:layout.select_targets]
wildcard_policy = single