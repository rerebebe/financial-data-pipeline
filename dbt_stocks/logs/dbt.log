    when not matched then insert
        (`symbol`, `quote_date`, `open_price`, `day_high`, `day_low`, `close_price`, `ingest_timestamp`, `data_source`, `previous_close_price`, `unique_int_id`, `open_price_validated`, `day_high_validated`, `day_low_validated`, `close_price_validated`)
    values
