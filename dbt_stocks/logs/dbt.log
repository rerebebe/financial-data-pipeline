    ),

    latest_indicators as (select * from `stock-market-project-487008`.`stock_market_data_marts`.`fct_latest_indicators`)

select
    tmb.symbol,
    tmb.quote_timestamp,
    tmb.open_price,
    tmb.day_high,
    tmb.day_low,
