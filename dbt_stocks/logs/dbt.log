        `symbol` = DBT_INTERNAL_SOURCE.`symbol`,`quote_date` = DBT_INTERNAL_SOURCE.`quote_date`,`open_price` = DBT_INTERNAL_SOURCE.`open_price`,`day_high` = DBT_INTERNAL_SOURCE.`day_high`,`day_low` = DBT_INTERNAL_SOURCE.`day_low`,`close_price` = DBT_INTERNAL_SOURCE.`close_price`,`ingest_timestamp` = DBT_INTERNAL_SOURCE.`ingest_timestamp`,`data_source` = DBT_INTERNAL_SOURCE.`data_source`,`previous_close_price` = DBT_INTERNAL_SOURCE.`previous_close_price`,`unique_int_id` = DBT_INTERNAL_SOURCE.`unique_int_id`,`open_price_validated` = DBT_INTERNAL_SOURCE.`open_price_validated`,`day_high_validated` = DBT_INTERNAL_SOURCE.`day_high_validated`,`day_low_validated` = DBT_INTERNAL_SOURCE.`day_low_validated`,`close_price_validated` = DBT_INTERNAL_SOURCE.`close_price_validated`
    

