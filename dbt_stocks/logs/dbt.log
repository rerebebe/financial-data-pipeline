select
    tmb.symbol,
    tmb.quote_timestamp,
    tmb.open_price,
    tmb.day_high,
    tmb.day_low,
    tmb.current_price,
    tmb.daily_price_change,
    tmb.daily_price_change_percentage,

    li.sma_20,
    li.sma_50,
    li.sma_200,
    li.ema_9,
    li.ema_20,
    li.rsi_14
from today_minutes_base tmb
left join latest_indicators li on tmb.symbol = li.symbol;


